# ===========================================================
# MPL API — environment variables (apps/api)
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Loaded via dotenv (and prisma.config.ts reads DATABASE_URL).
# ===========================================================

# ── Core (required) ───────────────────────────────────────
# PostgreSQL connection string. Prisma 7 reads this from prisma.config.ts.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/mpl_logistics"

# API server port
PORT=3001

# ── CORS: exact-origin allowlist ──────────────────────────
# Client app origin (the Vite dev server locally; app.<domain> in production).
CLIENT_URL="http://localhost:5173"

# Admin panel origin. Required once admin lives on its own hostname
# (admin.<domain>) — with only CLIENT_URL set, the admin panel is blocked by CORS.
# ADMIN_URL="https://admin.example.com"

# Any additional exact origins, comma-separated. Never use a wildcard: it is
# incompatible with credentials:true (cookie auth) and would allow any site to
# call the API with a logged-in user's credentials.
# CORS_ORIGINS="https://staging.example.com,http://localhost:4173"

# ── Reverse proxy ─────────────────────────────────────────
# Number of proxies in front of the app. 0 = none (local dev).
#   cloudflared only              → 1
#   Caddy in front of cloudflared → 2
# ⚠️ Must be EXACT. Too low and rate limiting keys on the proxy's IP so everyone
# shares one bucket; too high and a caller can forge X-Forwarded-For to get a
# fresh bucket per request, bypassing rate limiting completely.
TRUST_PROXY_HOPS=0

# JWT signing secret — generate a long random value, e.g.: openssl rand -hex 64
JWT_SECRET="CHANGE_ME_generate_a_long_random_secret"

# ── Sessions (Phase 2a) ───────────────────────────────────
# Server-side sessions. Login sets an httpOnly cookie AND still returns the legacy
# body token, so the existing localStorage frontend keeps working until the 2f
# cutover. All optional — the defaults below are what the code uses.
#
# SESSION_ABSOLUTE_HOURS=8      # hard lifetime (the old Bearer JWT was 7 DAYS)
# SESSION_IDLE_MINUTES=120      # revoked after this much inactivity (was 30)
# SESSION_COOKIE_NAME=mpl_session
#
# Client sessions are intentionally SEPARATE and much longer. The 8h/2h numbers above
# exist because the admin panel is the high-value internet-facing target; clients are
# far lower risk, and shortening theirs as a side effect of admin hardening would just
# log them out mid-errand.
# CLIENT_SESSION_ABSOLUTE_HOURS=168     # 7 days
# CLIENT_SESSION_IDLE_MINUTES=10080     # 7 days
#
# ⚠️ These two depend on the final domains AND the §1 LAN-fallback constraint —
# admin must resolve under ONE https hostname from both the LAN and the tunnel,
# or Secure/SameSite behave differently on the two paths. Leave defaults in dev.
# SESSION_COOKIE_SAMESITE=lax   # lax | strict | none  (none forces Secure on)
# SESSION_COOKIE_SECURE=false   # auto-true when NODE_ENV=production
# SESSION_COOKIE_DOMAIN=        # only if cookies must span subdomains

# ── Admin 2FA: emailed one-time code (Phase 2d) ───────────
# OFF by default — this is the kill switch. Also the mitigation for the one real
# weakness of email 2FA: if SMTP breaks or hits its daily cap, NOBODY can log in,
# so flipping this to false is how you get back in.
ADMIN_2FA_EMAIL=false
#
# No enrolment step: every admin has an email, so it is simply on or off for all.
# ADMIN_2FA_TTL_MINUTES=10      # how long a code is valid
# ADMIN_2FA_MAX_ATTEMPTS=5      # guesses allowed per code
# ADMIN_2FA_MAX_PER_WINDOW=5    # codes per admin per window (bounds email cost/spam)
#
# 💡 With SMTP unconfigured and NODE_ENV != production, the code is returned in the
# login response as `devCode` and logged — so the flow is testable before you have
# SMTP credentials. Never happens in production.

# ── Invite / reset link lifetimes (hours) ─────────────────
# How long a generated link stays usable. Both default to 1 day.
# MAGIC_LINK_HOURS=24           # registration invite (default 24 = 1 day; was 168/7 days)
# RESET_LINK_HOURS=24           # password-reset link  (default 24 = 1 day)
#
# ⚠️ Raise with care. Unlike a session these are single-use, but the token sits in an
# inbox or a WhatsApp thread for the whole window, and anyone holding it can create an
# account (registration) or take one over (reset). Prefer re-issuing an expired link
# over a long window. The reset link is the more sensitive of the two — keep it short.

# ── Trusted devices (Phase 2e) ────────────────────────────
# "Don't ask for an email code on this browser for N days." Deliberately separate
# from the session: the session stays short (8h / 2h idle) because that is what a
# stolen cookie replays, while this only removes the OTP step and still requires
# the password.
# TRUSTED_DEVICE_DAYS=7
# TRUSTED_DEVICE_COOKIE_NAME=mpl_device
#
# Forgotten automatically when the password changes, and by
# DELETE /api/auth/admin/sessions. Logout with ?forgetDevice=1 drops it too.

# ── Skip app 2FA when Cloudflare Access already verified (Phase 2d) ───
# On the tunnel path Access sends its own email OTP, so a second emailed code means
# two emails for one factor. Set BOTH of these and the app code is skipped for an
# identity Access has proven. The LAN fallback bypasses Access, so it still applies there.
#
# 🔴 FAILS CLOSED. Unset, unreachable keys, bad signature, wrong audience -> the app
# code is still required. The Cf-Access-Authenticated-User-Email header is NEVER
# trusted on its own; the signed Cf-Access-Jwt-Assertion is verified against
# Cloudflare's published keys. Verified by test: forged headers do not skip.
# CF_ACCESS_TEAM_DOMAIN="yourteam.cloudflareaccess.com"
# CF_ACCESS_AUD="<Application Audience tag from the Access app>"

# ── CSRF (Phase 2b) ───────────────────────────────────────
# Signed double-submit, enforced ONLY for requests that authenticate via the
# session cookie — the Bearer path is immune, so the current frontend is
# unaffected. Optional: falls back to JWT_SECRET.
# CSRF_SECRET="CHANGE_ME_generate_a_long_random_secret"
#
# Frontend contract for the 2f cutover: read the `mpl_csrf` cookie and echo it
# in an `x-csrf-token` header on every POST/PATCH/PUT/DELETE. GET /api/auth/csrf
# mints a fresh one if the page reloaded and lost it.

# ── Login lockout (Phase 2c) ──────────────────────────────
# Failed-login throttling on two axes. Rate limiting alone is per-IP, so an
# attacker with a few IPs could grind one account indefinitely.
# All optional; defaults shown.
#
# LOGIN_WINDOW_MINUTES=15            # window failures are counted over
# LOGIN_MAX_FAILURES_PER_EMAIL=5     # per-account threshold
# LOGIN_MAX_FAILURES_PER_IP=20       # per-host threshold (sprays many accounts)
# LOGIN_LOCKOUT_MINUTES=15           # how long a lock lasts, from the last failure
#
# ⚠️ An email lockout is itself a DoS vector — anyone can lock a known admin out
# by failing logins at their address. Kept SHORT and self-expiring rather than
# sticky for that reason. If staff report surprise lockouts, that's the signal to
# investigate, not a number to quietly raise.

# ── Signed file URLs (/api/files) ─────────────────────────
# /api/files cannot use an Authorization header — a browser can't attach one to
# <img src> — so access is proven by a signature in the URL instead. The API only
# mints those inside responses the caller was already authorised to receive.
#
# Optional: falls back to JWT_SECRET if unset, so no config is required.
# Rotating either invalidates outstanding file URLs; they self-heal on next page load.
# FILE_URL_SECRET="CHANGE_ME_generate_a_long_random_secret"
#
# How long a file URL stays valid. A URL lives between 1x and 2x this value and is
# byte-identical (therefore browser-cacheable) for the rest of its window — which is
# what stops the 8s dashboard poll re-downloading every photo. Default 60.
# Keep it short enough that a leaked link dies, long enough that a page left open
# doesn't show broken images.
# FILE_URL_TTL_MINUTES=60

# ── Cloudflare Turnstile (bot protection) ─────────────────
# The SECRET key, paired with VITE_TURNSTILE_SITE_KEY in apps/web. The site key is
# public by design; this one must never reach the client bundle.
# Without it, verification is SKIPPED and a warning is logged at startup — the
# widget alone protects nothing, since any caller can bypass it with a direct request.
#
# Cloudflare's documented test secrets (https://developers.cloudflare.com/turnstile/troubleshooting/testing/):
#   1x0000000000000000000000000000000AA  → always passes
#   2x0000000000000000000000000000000AA  → always fails
#   3x0000000000000000000000000000000AA  → token already spent
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# When "true", a request to a protected public endpoint with NO captcha token is
# rejected (400). Default off, because no frontend form sends a token yet — failing
# closed now would break client registration and password reset.
# A token that IS supplied is always verified regardless of this flag.
# 🔴 Set to "true" at launch, once the forms are wired, or the protection is optional
#    and therefore useless.
TURNSTILE_ENFORCE=false

# ── WhatsApp gateway: OpenWA (services/OpenWA) ────────────
# Self-hosted OpenWA REST gateway. If unset, sendWhatsApp() degrades to a
# no-op warning (no crash). See services/OpenWA.
OPENWA_BASE_URL="http://localhost:2785"
# OpenWA API key. For local dev with ALLOW_DEV_API_KEY=true it is "dev-admin-key";
# otherwise use the API_MASTER_KEY / generated key from OpenWA.
OPENWA_API_KEY="dev-admin-key"
# The id of the started/linked session in OpenWA (from the dashboard/API).
OPENWA_SESSION_ID=""

# ── File storage (upload helper) ──────────────────────────
# local = disk under STORAGE_LOCAL_PATH (dev). Swap to a cloud driver for prod.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads"

# ── Email delivery (email.ts) ─────────────────────────────
# 🔴 NO LONGER OPTIONAL once ADMIN_2FA_EMAIL=true — it becomes the login path.
# Unset, sends degrade to a warning (no crash) and the login code is surfaced as
# `devCode` outside production.
#
# Free tiers cover this easily (~50 emails/day expected):
#   Brevo   300/day forever   | Resend 3,000/month | SES $0.10 per 1,000
# ⚠️ Sending from your own domain needs SPF + DKIM DNS records, or codes land in
# spam — so this depends on the §7 domain decision.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ── Admin alert recipients (optional; alertScheduler.ts) ──
# Where document-expiry alerts are sent. If unset, that alert path no-ops.
ADMIN_EMAIL=""
ADMIN_WHATSAPP=""
